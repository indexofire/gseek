# Normalize text files to LF; keep binaries and generated archives untouched.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.gz binary
*.bz2 binary
*.xz binary
*.zip binary
*.whl binary
*.tar.gz binary
*.delta binary

# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
