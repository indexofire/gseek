digraph architecture {
  graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.32", ranksep="0.30",
         fontname="Noto Sans CJK SC", fontsize="12"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize="12",
        margin="0.30,0.18", penwidth="1.3"];
  edge [color="#7986cb", penwidth="1.6", arrowsize="0.80"];

  consumers [label=<<B>Consumers</B><BR/><FONT POINT-SIZE="11">gside · gapit · gmlst · your pipeline</FONT>>,
             fillcolor="#e8eaf6", color="#c5cae9", fontcolor="#1a237e"];

  api [label=<<B>gseek.api</B><BR/><FONT POINT-SIZE="11">align · distance · backends · replay</FONT>>,
       fillcolor="#3f51b5", color="#3f51b5", fontcolor="white", penwidth="1.5"];

  runner [label=<<B>Runner</B><BR/><FONT POINT-SIZE="11">probe → index → plan → execute → parse → manifest</FONT>>,
          fillcolor="#fff8e1", color="#ffe0b2", fontcolor="#4e342e"];

  adapters [label=<<B>Adapters</B> — pure planners and parsers<BR/><FONT POINT-SIZE="11">BLAST+ · minimap2 · MUMmer4 · KMA<BR/>BWA · mash · sourmash · skani</FONT>>,
            fillcolor="#e0f2f1", color="#b2dfdb", fontcolor="#004d40"];

  records [label=<<B>Output</B><BR/><FONT POINT-SIZE="11">normalized records · 0-based half-open · stable order · provenance</FONT>>,
           fillcolor="#e8f5e9", color="#a5d6a7", fontcolor="#1b5e20"];

  consumers -> api -> runner -> adapters -> records;
}
