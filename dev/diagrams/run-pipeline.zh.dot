digraph pipeline {
  graph [rankdir=TB, bgcolor="white", pad="0.20", nodesep="0.20", ranksep="0.24",
         fontname="Noto Sans CJK SC", fontsize="10"];
  node [shape=box, style="rounded,filled", width="5.8", fontname="Noto Sans CJK SC",
        fontsize="9", margin="0.18,0.10", penwidth="1.2"];
  edge [color="#7986cb", penwidth="1.3", arrowsize="0.7"];

  request [label=<<B>1 · 校验请求</B><BR/><FONT POINT-SIZE="8">适配器 · 输入 · 参数</FONT>>,
           fillcolor="#e8eaf6", color="#c5cae9", fontcolor="#1a237e"];
  probe [label=<<B>2 · 探测工具</B><BR/><FONT POINT-SIZE="8">解析路径 + 版本</FONT>>,
         fillcolor="#e8eaf6", color="#c5cae9", fontcolor="#1a237e"];
  index [label=<<B>3 · 解析或构建索引</B><BR/><FONT POINT-SIZE="8">内容寻址 key + 缓存</FONT>>,
         fillcolor="#e8eaf6", color="#c5cae9", fontcolor="#1a237e"];
  plan [label=<<B>4 · 规划命令</B><BR/><FONT POINT-SIZE="8">仅 argv，无 shell</FONT>>,
        fillcolor="#fff8e1", color="#ffe0b2", fontcolor="#4e342e"];
  execute [label=<<B>5 · 执行</B><BR/><FONT POINT-SIZE="8">仅 gseek.execution 启动子进程</FONT>>,
           fillcolor="#fff8e1", color="#ffe0b2", fontcolor="#4e342e"];
  parse [label=<<B>6 · 解析 + 归一化</B><BR/><FONT POINT-SIZE="8">0-based half-open records</FONT>>,
         fillcolor="#e8f5e9", color="#a5d6a7", fontcolor="#1b5e20"];
  manifest [label=<<B>7 · 排序 + manifest</B><BR/><FONT POINT-SIZE="8">稳定顺序 · gseek.run/1（可选）</FONT>>,
            fillcolor="#e8f5e9", color="#a5d6a7", fontcolor="#1b5e20"];

  request -> probe -> index -> plan -> execute -> parse -> manifest;
}
